<%= form_with model: @project, class: "space-y-6 bg-white p-6 rounded-2xl shadow" do |f| %>

  <div>
    <%= f.label :name, class: "block font-medium mb-1 text-black" %>
    <%= f.text_field :name,
        class: "w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-500 text-black bg-white" %>
  </div>

  <div>
    <%= f.label :description, class: "block font-medium mb-1 text-black" %>
    <%= f.text_area :description, rows: 4,
        class: "w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-500 text-black bg-white" %>
  </div>

  <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 cursor-pointer transition-colors" %>

<% end %>
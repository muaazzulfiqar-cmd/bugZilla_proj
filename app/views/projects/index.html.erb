<div class="flex justify-between items-center mb-6">
  <h1 class="text-3xl font-bold text-white">Projects</h1>
  <%= link_to "New Project", new_project_path,
    class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
</div>

<!-- My Projects Section -->
<% if @my_projects.any? %>
  <div class="mb-10">
    <h2 class="text-2xl font-semibold text-white mb-4 flex items-center">
      <span>My Projects</span>
      <span class="ml-3 text-sm bg-blue-100 text-blue-800 px-3 py-1 rounded-full">
        <%= @my_projects.count %>
      </span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% @my_projects.each do |project| %>
        <% membership = current_user.project_memberships.find_by(project: project) %>
        <div class="bg-white p-6 rounded-2xl shadow hover:shadow-lg transition-shadow border-l-4 
          <%= case membership.role
              when 'manager' then 'border-green-500'
              when 'developer' then 'border-blue-500'
              when 'qa' then 'border-orange-500'
              end %>">
          
          <div class="flex justify-between items-start">
            <h3 class="text-xl font-semibold mb-2 text-black">
              <%= link_to project.name, project, class: "hover:text-blue-600 hover:underline" %>
            </h3>
            <span class="px-3 py-1 text-xs rounded-full
              <%= case membership.role
                  when 'manager' then 'bg-green-100 text-green-800'
                  when 'developer' then 'bg-blue-100 text-blue-800'
                  when 'qa' then 'bg-orange-100 text-orange-800'
                  end %>">
              <%= membership.role.humanize %>
            </span>
          </div>
          
          <p class="text-gray-700 mb-3"><%= project.description.truncate(100) %></p>
          
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-600">
              Created by: <%= project.creator.email %>
            </span>
            <span class="text-gray-600">
              <%= project.bugs.count %> bugs
              <% if project.bugs.open.any? %>
                <span class="text-red-600 ml-1">(<%= project.bugs.open.count %> open)</span>
              <% end %>
            </span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<!-- All Projects Section -->
<div class="mb-6">
  <h2 class="text-2xl font-semibold text-white mb-4 flex items-center">
    <span>All Projects</span>
    <span class="ml-3 text-sm bg-gray-200 text-gray-800 px-3 py-1 rounded-full">
      <%= @all_projects.count %> total
    </span>
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @all_projects.each do |project| %>
      <% membership = current_user.project_memberships.find_by(project: project) %>
      <div class="bg-white p-6 rounded-2xl shadow hover:shadow-lg transition-shadow border <%= membership ? 'border-blue-200' : 'border-gray-200' %>">
        
        <h3 class="text-xl font-semibold mb-2 text-black">
          <%= link_to project.name, project, class: "hover:text-blue-600 hover:underline" %>
        </h3>
        
        <p class="text-gray-700 mb-3 text-sm"><%= project.description.truncate(80) %></p>
        
        <div class="flex items-center justify-between text-xs">
        <span class="text-gray-600">
          By: <%= project.creator&.email&.split('@')&.first || "Deleted User" %>
        </span>
          
          <div class="flex items-center gap-2">
            <% if membership %>
              <span class="px-2 py-1 rounded-full text-xs
                <%= case membership.role
                    when 'manager' then 'bg-green-100 text-green-800'
                    when 'developer' then 'bg-blue-100 text-blue-800'
                    when 'qa' then 'bg-orange-100 text-orange-800'
                    end %>">
                <%= membership.role.humanize %>
              </span>
            <% else %>
              <span class="text-gray-400">Not a member</span>
            <% end %>
            
            <span class="text-gray-500">
              <%= project.bugs.count %> bugs
            </span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
<div class="mt-8 flex justify-center">
    <%= paginate @all_projects %>
</div>
<% if @all_projects.empty? %>
  <div class="text-center py-12 bg-white rounded-2xl shadow">
    <p class="text-gray-700 mb-4">No projects exist yet.</p>
    <%= link_to "Create Your First Project", new_project_path,
        class: "bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors inline-block" %>
  </div>
<% end %>
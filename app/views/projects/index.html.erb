<div class="flex justify-between items-center mb-6">
  <h1 class="text-3xl font-bold text-black">Projects</h1>
  <%= link_to "New Project", new_project_path,
    class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <% @projects.each do |project| %>
    <div class="bg-white p-6 rounded-2xl shadow hover:shadow-lg transition-shadow border border-gray-100">
      <h2 class="text-xl font-semibold mb-2 text-black">
        <%= link_to project.name, project, class: "text-black hover:text-blue-600 hover:underline" %>
      </h2>
      <p class="text-gray-700"><%= project.description.presence || "No description provided" %></p>
      
      <% if project.bugs.any? %>
        <div class="mt-4 pt-3 border-t border-gray-200">
          <p class="text-sm text-gray-600">
            <span class="font-medium text-black">Bugs:</span> 
            <span class="<%= project.bugs.open.count > 0 ? 'text-red-600' : 'text-green-600' %>">
              <%= project.bugs.open.count %> open
            </span>
            /
            <span class="text-gray-700"><%= project.bugs.count %> total
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<% if @projects.empty? %>
  <div class="text-center py-12 bg-white rounded-2xl shadow">
    <p class="text-gray-700 mb-4">You don't have any projects yet.</p>
    <%= link_to "Create Your First Project", new_project_path,
        class: "bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors inline-block" %>
  </div>
<% end %>
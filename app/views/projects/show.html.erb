<div class="mb-6">
  <h1 class="text-3xl font-bold text-black"><%= @project.name %></h1>
  <p class="text-gray-700 mt-2"><%= @project.description.presence || "No description provided" %></p>
</div>

<div class="flex gap-4 mb-6 flex-wrap">
  <%= link_to "Edit", edit_project_path(@project),
      class: "bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-600 transition-colors" %>

  <%= link_to "Delete", @project,
      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
      class: "bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors" %>

  <%= link_to "Report Bug", new_project_bug_path(@project),
      class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>

  <%= link_to "Manage Team", project_project_memberships_path(@project),
      class: "bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition-colors" %>
</div>

<!-- Team Members Section -->
<div class="bg-white p-6 rounded-2xl shadow mb-8">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-2xl font-semibold text-black">Team Members (<%= @project.users.count %>)</h2>
    <%= link_to "Manage Team", project_project_memberships_path(@project),
        class: "text-blue-600 hover:underline text-sm" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @project.project_memberships.includes(:user).each do |membership| %>
      <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
        <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white font-semibold">
          <%= membership.user.email[0].upcase %>
        </div>
        <div class="flex-1">
          <p class="font-medium text-black text-sm truncate" title="<%= membership.user.email %>">
            <%= membership.user.email %>
          </p>
          <div class="flex items-center gap-2 mt-1">
            <span class="px-2 py-0.5 text-xs rounded-full 
              <%= case membership.role
                  when 'manager' then 'bg-green-100 text-green-800'
                  when 'developer' then 'bg-blue-100 text-blue-800'
                  when 'qa' then 'bg-orange-100 text-orange-800'
                  end %>">
              <%= membership.role.humanize %>
            </span>
            <% if membership.user == @project.creator %>
              <span class="text-xs bg-purple-100 text-purple-800 px-2 py-0.5 rounded-full">Creator</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Bugs Section (rest of your existing code) -->
<div class="mb-6">
  <div class="flex justify-between items-center">
    <h2 class="text-2xl font-semibold text-black">Bugs</h2>
    <span class="text-gray-600 text-sm">
      <%= @bugs.count %> total
      (<span class="text-red-600"><%= @bugs.open.count %> open</span>,
       <span class="text-green-600"><%= @bugs.resolved.count %> resolved</span>)
    </span>
  </div>
</div>


<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-white">Manage Users</h1>
    <div class="flex gap-3">
      <span class="bg-purple-100 text-purple-800 px-4 py-2 rounded-full text-sm">
        <%= @totalusers.count %> total users
      </span>
      <span class="bg-green-100 text-green-800 px-4 py-2 rounded-full text-sm">
        <%= @totalusers.where(global_role: :admin).count %> admins
      </span>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Global Role</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Projects</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reported Bugs</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned Bugs</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Member Since</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= user.id %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900"><%= user.email %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= form_with model: user, local: true, class: "inline-block" do |f| %>
                <%= f.select :global_role, 
                    User.global_roles.keys.map { |r| [r.humanize, r] },
                    {},
                    class: "text-sm border rounded-lg p-1 text-black bg-white",
                    onchange: "this.form.submit()",
                    disabled: user == current_user # Can't change your own role
                %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= user.projects.count %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= user.reported_bugs.count %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= user.assigned_bugs.count %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= user.created_at.strftime("%b %d, %Y") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <% if user != current_user %>
                <%= button_to "Delete", user_path(user), 
                    method: :delete,
                    class: "text-red-600 hover:text-red-900 bg-transparent border-0 cursor-pointer",
                    data: { turbo_confirm: "Are you sure you want to delete this user? This will remove them from all projects and reassign their bugs." } %>
              <% else %>
                <span class="text-gray-400">(You)</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <!-- User Stats Summary -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-white p-4 rounded-2xl shadow">
      <p class="text-sm text-gray-600">Total Users</p>
      <p class="text-2xl font-bold text-black"><%= @totalusers.count %></p>
    </div>
    <div class="bg-white p-4 rounded-2xl shadow">
      <p class="text-sm text-gray-600">Admins</p>
      <p class="text-2xl font-bold text-purple-600"><%= @totalusers.where(global_role: :admin).count %></p>
    </div>
    <div class="bg-white p-4 rounded-2xl shadow">
      <p class="text-sm text-gray-600">Employees</p>
      <p class="text-2xl font-bold text-blue-600"><%= @totalusers.where(global_role: :employee).count %></p>
    </div>
    <div class="bg-white p-4 rounded-2xl shadow">
      <p class="text-sm text-gray-600">Total Projects</p>
      <p class="text-2xl font-bold text-green-600"><%= Project.count %></p>
    </div>
  </div>
</div>

<div class="mt-8 flex justify-center">
  <%= paginate @users %>
</div>
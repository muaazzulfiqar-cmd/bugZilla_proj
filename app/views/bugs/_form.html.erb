<%# app/views/bugs/_form.html.erb %>
<%# Handle both local variables and instance variables %>
<% project ||= @project %>
<% bug ||= @bug %>

<%= form_with model: [project, bug], class: "space-y-6 bg-white p-6 rounded-2xl shadow", multipart: true do |f| %>

  <div>
    <%= f.label :title, class: "block font-medium mb-1 text-black" %>
    <%= f.text_field :title,
        class: "w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-500 text-black bg-white" %>
  </div>

  <div>
    <%= f.label :description, class: "block font-medium mb-1 text-black" %>
    <%= f.text_area :description, rows: 4,
        class: "w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-500 text-black bg-white" %>
  </div>

  <div>
    <%= f.label :status, class: "block font-medium mb-1 text-black" %>
    <%= f.select :status, Bug.statuses.keys.map { |s| [s.humanize, s] },
        {}, class: "w-full border rounded-lg p-2 text-black bg-white" %>
  </div>

  <div>
    <%= f.label :priority, class: "block font-medium mb-1 text-black" %>
    <%= f.select :priority, Bug.priorities.keys.map { |p| [p.humanize, p] },
        {}, class: "w-full border rounded-lg p-2 text-black bg-white" %>
  </div>

  <div>
    <%= f.label :assignee_id, "Assign To", class: "block font-medium mb-1 text-black" %>
    <%= f.collection_select :assignee_id,
        project.users,
        :id,
        :email,
        { include_blank: "Unassigned" },
        class: "w-full border rounded-lg p-2 text-black bg-white" %>
  </div>

  <div>
    <%= f.label :screenshots, class: "block font-medium mb-1 text-black" %>
    <%= f.file_field :screenshots, multiple: true,
        class: "w-full border rounded-lg p-2 text-black bg-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100",
        accept: "image/png,image/jpg,image/jpeg,image/gif" %>
    <p class="text-sm text-gray-600 mt-1">You can select multiple images (PNG, JPG, JPEG, GIF)</p>
    
    <% if bug.screenshots.attached? %>
      <div class="mt-3">
        <p class="text-sm font-medium text-black mb-2">Current screenshots:</p>
        <div class="flex flex-wrap gap-2">
          <% bug.screenshots.each do |shot| %>
            <div class="relative">
              <%= image_tag shot, class: "w-20 h-20 object-cover rounded-lg border border-gray-200" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 cursor-pointer transition-colors" %>
    <%= link_to "Cancel", [project, bug], class: "bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors" %>
  </div>

<% end %>
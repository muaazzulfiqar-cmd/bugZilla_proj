<%# app/views/bug_mailer/bug_assigned.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto;">
  <div style="background-color: #DC2626; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
    <h1 style="margin: 0; font-size: 24px;">🐛 New Bug Assigned to You</h1>
  </div>
  
  <div style="background-color: #f9f9f9; padding: 30px; border-radius: 0 0 8px 8px; border: 1px solid #e0e0e0;">
    <p style="font-size: 16px;">Hello <strong><%= @assignee.email %></strong>,</p>
    
    <p style="font-size: 16px;">A new bug has been assigned to you in project <strong><%= @project.name %></strong>:</p>
    
    <div style="background-color: white; padding: 20px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #DC2626;">
      <h2 style="margin-top: 0; color: #DC2626;"><%= @bug.title %></h2>
      
      <p style="margin: 10px 0;"><strong>📝 Description:</strong><br>
      <%= @bug.description %></p>
      
      <div style="display: flex; gap: 10px; margin: 15px 0;">
        <span style="background-color: #FEE2E2; color: #DC2626; padding: 4px 12px; border-radius: 20px; font-size: 14px;">
          Status: <%= @bug.status.humanize %>
        </span>
        <span style="background-color: #FEF3C7; color: #D97706; padding: 4px 12px; border-radius: 20px; font-size: 14px;">
          Priority: <%= @bug.priority.humanize %>
        </span>
      </div>
      
      <p style="margin: 5px 0;"><strong>👤 Reported by:</strong> <%= @reporter.email %></p>
      <p style="margin: 5px 0;"><strong>📅 Created:</strong> <%= @bug.created_at.strftime("%B %d, %Y") %></p>
    </div>
    
    <div style="text-align: center; margin: 30px 0;">
      <a href="<%= project_bug_url(@project, @bug) %>" style="background-color: #DC2626; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold;">View Bug Details</a>
    </div>
    
    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;">
    
    <p style="font-size: 14px; color: #666; text-align: center;">
      Bugzilla - Track your bugs efficiently
    </p>
  </div>
</body>
</html>

<%# Plain text version %>
<%# app/views/bug_mailer/bug_assigned.text.erb %>
Hello <%= @assignee.email %>,

A new bug has been assigned to you in project <%= @project.name %>:

Title: <%= @bug.title %>
Description: <%= @bug.description %>
Status: <%= @bug.status.humanize %>
Priority: <%= @bug.priority.humanize %>
Reported by: <%= @reporter.email %>

View the bug here: <%= project_bug_url(@project, @bug) %>
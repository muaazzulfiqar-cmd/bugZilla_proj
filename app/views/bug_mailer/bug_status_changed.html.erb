<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto;">
  <div style="background-color: #3B82F6; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
    <h1 style="margin: 0; font-size: 24px;">🔄 Bug Status Changed</h1>
  </div>
  
  <div style="background-color: #f9f9f9; padding: 30px; border-radius: 0 0 8px 8px; border: 1px solid #e0e0e0;">
    <p style="font-size: 16px;">Hello,</p>
    
    <p style="font-size: 16px;">The status of a bug has been updated in project <strong><%= @project.name %></strong>:</p>
    
    <div style="background-color: white; padding: 20px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #3B82F6;">
      <h2 style="margin-top: 0; color: #1F2937;"><%= @bug.title %></h2>
      
      <p style="margin: 10px 0;"><strong>Description:</strong> <%= @bug.description %></p>
      
      <div style="display: flex; gap: 10px; margin: 15px 0; flex-wrap: wrap;">
        <span style="background-color: #DBEAFE; color: #1E40AF; padding: 4px 12px; border-radius: 20px; font-size: 14px;">
          Old Status: <strong><%= @old_status.to_s.humanize %></strong>
        </span>
        <span style="background-color: #DEF7EC; color: #03543F; padding: 4px 12px; border-radius: 20px; font-size: 14px;">
          New Status: <strong><%= @new_status.to_s.humanize %></strong>
        </span>
      </div>
      
      <div style="display: flex; gap: 10px; margin: 15px 0; flex-wrap: wrap;">
        <span style="background-color: #F3F4F6; color: #374151; padding: 4px 12px; border-radius: 20px; font-size: 14px;">
          Priority: <%= @bug.priority.to_s.humanize %>
        </span>
        <span style="background-color: #F3F4F6; color: #374151; padding: 4px 12px; border-radius: 20px; font-size: 14px;">
          Assignee: <%= @bug.assignee&.email || "Unassigned" %>
        </span>
      </div>
      
      <p style="margin: 5px 0;"><strong>Reported by:</strong> <%= @bug.reporter.email %></p>
    </div>
    
    <div style="text-align: center; margin: 30px 0;">
      <a href="<%= project_bug_url(@project, @bug) %>" style="background-color: #3B82F6; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold;">View Bug Details</a>
    </div>
    
    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;">
    
    <p style="font-size: 14px; color: #666; text-align: center;">
      Bugzilla - Track your bugs efficiently<br>
      This is an automated message, please do not reply.
    </p>
  </div>
</body>
</html>
<%# app/views/bug_mailer/bug_deleted.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto;">
  <div style="background-color: #6B7280; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
    <h1 style="margin: 0; font-size: 24px;">🗑️ Bug Deleted</h1>
  </div>
  
  <div style="background-color: #f9f9f9; padding: 30px; border-radius: 0 0 8px 8px; border: 1px solid #e0e0e0;">
    <p style="font-size: 16px;">Hello <strong><%= @previous_assignee.email %></strong>,</p>
    
    <p style="font-size: 16px;">A bug that was assigned to you has been deleted from project <strong><%= @project.name %></strong>:</p>
    
    <div style="background-color: white; padding: 20px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #6B7280;">
      <h2 style="margin-top: 0; color: #6B7280;"><%= @bug.title %></h2>
      
      <p style="margin: 10px 0;"><strong>📝 Description:</strong><br>
      <%= @bug.description %></p>
      
      <div style="display: flex; gap: 10px; margin: 15px 0;">
        <span style="background-color: #F3F4F6; color: #374151; padding: 4px 12px; border-radius: 20px; font-size: 14px;">
          Status: <%= @bug.status.humanize %>
        </span>
        <span style="background-color: #F3F4F6; color: #374151; padding: 4px 12px; border-radius: 20px; font-size: 14px;">
          Priority: <%= @bug.priority.humanize %>
        </span>
      </div>
      
      <p style="margin: 5px 0;"><strong>👤 Deleted by:</strong> <%= @deleted_by.email %></p>
      <p style="margin: 5px 0;"><strong>📅 Deleted at:</strong> <%= Time.current.strftime("%B %d, %Y at %I:%M %p") %></p>
    </div>
    
    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;">
    
    <p style="font-size: 14px; color: #666; text-align: center;">
      Bugzilla - Track your bugs efficiently
    </p>
  </div>
</body>
</html>

<%# app/views/bug_mailer/bug_deleted.text.erb %>
Hello <%= @previous_assignee.email %>,

A bug that was assigned to you has been deleted from project <%= @project.name %>:

Title: <%= @bug.title %>
Description: <%= @bug.description %>
Status: <%= @bug.status.humanize %>
Priority: <%= @bug.priority.humanize %>
Deleted by: <%= @deleted_by.email %>

This bug is no longer available.
<div class="max-w-md mx-auto mt-10">
  <div class="bg-white p-8 rounded-lg shadow-md">
    
    <h2 class="text-2xl font-bold mb-6 text-center text-black">Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), 
                 data: { turbo: false }) do |f| %>

      <div class="mb-4">
        <%= f.label :email, class: "block text-sm font-medium mb-1 text-black" %>
        <%= f.email_field :email, 
            class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-black bg-white",
            placeholder: "your@email.com" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "block text-sm font-medium mb-1 text-black" %>
        <%= f.password_field :password, 
            class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-black bg-white",
            placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-4 flex items-center">
          <%= f.check_box :remember_me, 
              class: "mr-2 h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          <%= f.label :remember_me, class: "text-sm text-black" %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.submit "Log in", 
            class: "w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 cursor-pointer font-medium" %>
      </div>
    <% end %>

    <div class="text-center text-sm space-y-2">
      <%= link_to "Sign up", new_registration_path(resource_name), 
          class: "text-blue-600 hover:underline block" %>
      <%= link_to "Forgot password?", new_password_path(resource_name), 
          class: "text-gray-600 hover:underline block" %>
    </div>
  </div>
</div>
<div class="max-w-md mx-auto mt-10">
  <div class="bg-white p-8 rounded-lg shadow-md">
    
    <h2 class="text-2xl font-bold mb-6 text-center text-black">Create an account</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), 
                 data: { turbo: false }) do |f| %>
      
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Email -->
      <div class="mb-4">
        <%= f.label :email, class: "block text-sm font-medium mb-1 text-black" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-black bg-white",
            placeholder: "your@email.com" %>
      </div>

      <!-- Password -->
      <div class="mb-4">
        <%= f.label :password, class: "block text-sm font-medium mb-1 text-black" %>
        <% if @minimum_password_length %>
          <span class="text-xs text-gray-500">(<%= @minimum_password_length %> characters min)</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-black bg-white",
            placeholder: "••••••••" %>
      </div>

      <!-- Password Confirmation -->
      <div class="mb-4">
        <%= f.label :password_confirmation, class: "block text-sm font-medium mb-1 text-black" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-black bg-white",
            placeholder: "••••••••" %>
      </div>

      <!-- Account Type Selection -->
      <div class="mb-4">
        <%= f.label :selected_global_role, "Account type", class: "block text-sm font-medium mb-1 text-black" %>
        <%= f.select :selected_global_role, 
            options_for_select([
              ["Select type", ""], 
              ["Admin", "admin"], 
              ["Employee", "employee"]
            ], params.dig(:user, :selected_global_role)),
            {}, 
            class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-black bg-white",
            id: "global_role_select" %>
        <p class="text-xs text-gray-500 mt-1">Admin: Full system access | Employee: Project-based access</p>
      </div>

      <!-- Role Password (hidden by default) -->
      <div id="role_password_container" class="mb-4">
        <%= f.label :role_password, "Role password", class: "block text-sm font-medium mb-1 text-black" %>
        <%= f.password_field :role_password,
            class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-black bg-white",
            placeholder: "Enter special password for this role",
            value: params.dig(:user, :role_password) %>
      </div>

      <!-- Submit Button -->
      <div class="mb-4">
        <%= f.submit "Sign up", 
            class: "w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 cursor-pointer font-medium" %>
      </div>
    <% end %>

    <!-- Links -->
    <div class="text-center text-sm">
      <%= link_to "Already have an account? Log in", new_session_path(resource_name), 
          class: "text-blue-600 hover:underline" %>
    </div>
  </div>
</div>

<!-- JavaScript for toggling role password field -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const roleSelect = document.getElementById('global_role_select');
    const passwordContainer = document.getElementById('role_password_container');
    
    if (roleSelect && passwordContainer) {
      function togglePasswordField() {
        if (roleSelect.value && roleSelect.value !== "") {
          passwordContainer.classList.remove('hidden');
        } else {
          passwordContainer.classList.add('hidden');
        }
      }
      
      togglePasswordField();
      roleSelect.addEventListener('change', togglePasswordField);
    }
  });
</script>

<style>
  .hidden { display: none !important; }
</style>